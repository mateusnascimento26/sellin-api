DATABASE_URL=postgresql+psycopg://sellin:sellin@localhost:5432/sellin
MAX_UPLOAD_SIZE_BYTES=20971520
# Chave secreta usada pra assinar o token de login (JWT) -- gere uma string
# aleatoria qualquer (ex: python -c "import secrets; print(secrets.token_hex(32))").
# No Render isso e' preenchido automaticamente (generateValue: true no render.yaml).
SECRET_KEY=troque-por-uma-chave-aleatoria

# Opcional: se preenchidos, a API cria esse usuario de login automaticamente
# na primeira vez que sobe (util pra criar o primeiro usuario num banco novo,
# ex: na nuvem, sem precisar rodar create_user.py manualmente).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Usado só pelo painel (streamlit_app.py) -- onde a API está rodando.
API_BASE_URL=http://127.0.0.1:8000
